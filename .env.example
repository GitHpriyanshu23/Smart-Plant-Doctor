# Supabase (frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase (backend)
SUPABASE_URL=https://yzpjyhrnkwmtsviysnre.supabase.co
SUPABASE_JWT_SECRET=your-jwt-secret-from-supabase-dashboard

# Supabase Postgres — copy from Dashboard → Project Settings → Database → Connection string
# Choose "Session pooler" (port 6543). Replace [password] with your DB password only — not your email.
# Example:
# DATABASE_URL=postgresql://postgres.yzpjyhrnkwmtsviysnre:YOUR_DB_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:6543/postgres
#
# Quick Railway fallback (no Supabase Postgres, data resets on redeploy):
# DATABASE_URL=sqlite:////tmp/smart_plant_doctor.db
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres

# API
PUBLIC_API_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,https://smart-plant-dr.vercel.app
GEMINI_API_KEY=
CONFIDENCE_THRESHOLD=0.70
MODEL_PATH=../ai/exports/smart_plant_doctor_model.pth

# Blynk IoT (device auth token from Blynk console)
BLYNK_AUTH_TOKEN=
BLYNK_SERVER=https://blr1.blynk.cloud
